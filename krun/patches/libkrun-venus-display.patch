diff --git a/src/devices/src/virtio/gpu/display.rs b/src/devices/src/virtio/gpu/display.rs
index 5bc6b17..fed48d3 100644
--- a/src/devices/src/virtio/gpu/display.rs
+++ b/src/devices/src/virtio/gpu/display.rs
@@ -62,6 +62,62 @@ impl DisplayInfo {
 
 pub const MAX_DISPLAYS: usize = VIRTIO_GPU_MAX_SCANOUTS as usize;
 
+/// Runtime display resizing (host window resized -> guest picks a new mode).
+///
+/// The host records the new size and raises VIRTIO_GPU_EVENT_DISPLAY through a
+/// config-change interrupt; the guest driver then re-reads GET_DISPLAY_INFO and
+/// GET_EDID, sends a hotplug uevent, and the compositor switches to the new
+/// preferred mode. One VM per process, so a process-wide state is sufficient.
+pub mod resize {
+    use crate::virtio::InterruptTransport;
+    use std::sync::atomic::{AtomicU32, Ordering};
+    use std::sync::Mutex;
+
+    use super::MAX_DISPLAYS;
+
+    pub const EVENT_DISPLAY: u32 = 1 << 0;
+
+    static SIZES: Mutex<[Option<(u32, u32)>; MAX_DISPLAYS]> = Mutex::new([None; MAX_DISPLAYS]);
+    static EVENTS: AtomicU32 = AtomicU32::new(0);
+    static INTERRUPT: Mutex<Option<InterruptTransport>> = Mutex::new(None);
+
+    pub fn set_interrupt(interrupt: InterruptTransport) {
+        *INTERRUPT.lock().unwrap() = Some(interrupt);
+    }
+
+    /// Current size of `scanout`, if the host has resized it since boot.
+    pub fn current(scanout: usize) -> Option<(u32, u32)> {
+        SIZES.lock().unwrap().get(scanout).copied().flatten()
+    }
+
+    pub fn events() -> u32 {
+        EVENTS.load(Ordering::SeqCst)
+    }
+
+    pub fn clear_events(mask: u32) {
+        EVENTS.fetch_and(!mask, Ordering::SeqCst);
+    }
+
+    /// Returns false if the scanout index is out of range.
+    pub fn request(scanout: usize, width: u32, height: u32) -> bool {
+        {
+            let mut sizes = SIZES.lock().unwrap();
+            let Some(slot) = sizes.get_mut(scanout) else {
+                return false;
+            };
+            if *slot == Some((width, height)) {
+                return true;
+            }
+            *slot = Some((width, height));
+        }
+        EVENTS.fetch_or(EVENT_DISPLAY, Ordering::SeqCst);
+        if let Some(interrupt) = INTERRUPT.lock().unwrap().as_ref() {
+            interrupt.signal_config_change();
+        }
+        true
+    }
+}
