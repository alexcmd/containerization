+
+/// Drain the cursor queue. UPDATE_CURSOR / MOVE_CURSOR carry no response and the
+/// host draws its own pointer, so each descriptor is returned immediately. If the
+/// queue is never serviced, the guest's cursor vq fills up, virtio_gpu_cursor_ping
+/// blocks in the kernel, and every display commit behind it hangs.
+pub fn run_cursor_drain(cursor_q: DeviceQueue, mem: GuestMemoryMmap, interrupt: InterruptTransport) {
+    let evt = cursor_q.event.try_clone().unwrap();
+    // SAFETY: evt is valid for the duration of the fcntl calls.
+    let fd = unsafe { BorrowedFd::borrow_raw(evt.as_raw_fd()) };
+    let flags = OFlag::from_bits_retain(fcntl(fd, FcntlArg::F_GETFL).unwrap()) & !OFlag::O_NONBLOCK;
+    fcntl(fd, FcntlArg::F_SETFL(flags)).unwrap();
+    let mut queue = cursor_q.queue;
+    thread::Builder::new()
+        .name("gpu cursor".into())
+        .spawn(move || loop {
+            if let Err(e) = evt.read() {
+                error!("Failed to read cursor_evt: {e:?}");
+                continue;
+            }
+            let mut used_any = false;
+            while let Some(head) = queue.pop(&mem) {
+                if let Err(e) = queue.add_used(&mem, head.index, 0) {
+                    error!("cursor queue add_used failed: {e:?}");
+                }
+                used_any = true;
+            }
+            if used_any {
+                if let Err(e) = interrupt.try_signal_used_queue() {
+                    error!("Error signaling cursor queue: {e:?}");
+                }
+            }
+        })
+        .unwrap();
+}
