+/// Resize display `display_id` of a running VM (e.g. its host window was resized).
+/// The guest is notified with VIRTIO_GPU_EVENT_DISPLAY and picks up the new
+/// size as its preferred mode. Safe to call from any thread after krun_start_enter.
+#[cfg(feature = "gpu")]
+#[no_mangle]
+pub extern "C" fn krun_display_resize(_ctx_id: u32, display_id: u32, width: u32, height: u32) -> i32 {
+    if width < 320 || height < 200 || width > 8192 || height > 8192 {
+        return -libc::EINVAL;
+    }
+    if devices::virtio::display::resize::request(display_id as usize, width, height) {
+        KRUN_SUCCESS
+    } else {
+        -libc::EINVAL
+    }
+}
+
+#[cfg(not(feature = "gpu"))]
+#[no_mangle]
+pub extern "C" fn krun_display_resize(_ctx_id: u32, _display_id: u32, _width: u32, _height: u32) -> i32 {
+    -libc::ENOTSUP
+}
